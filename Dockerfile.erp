# Dockerfile for the Mock ERP MCP sidecar service (Cloud Run internal).
# Runs the legacy ERP simulator on port 8001 for agent tool calls.

# --- Stage 1: Builder ---
FROM python:3.12-slim AS builder

WORKDIR /build

COPY pyproject.toml ./
COPY src/ src/

RUN pip install --no-cache-dir --prefix=/install .

# --- Stage 2: Runtime ---
FROM python:3.12-slim AS runtime

RUN groupadd --gid 1001 erpuser \
    && useradd --uid 1001 --gid erpuser --shell /bin/false erpuser

WORKDIR /app

COPY --from=builder /install /usr/local
COPY src/ src/
COPY configs/ configs/
COPY data/generated/ data/generated/

USER erpuser

ENV PORT=8001
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/src

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

CMD ["python", "-c", "import uvicorn; from invoiceops.config import load_config; from invoiceops.mcp_erp.flaky import FlakyInjector, FlakySettings; from invoiceops.mcp_erp.server import ErpDatabase, create_erp_app; from pathlib import Path; cfg = load_config(); db = ErpDatabase.from_seed_file(Path('data/generated/erp_seed.json')); flaky = FlakyInjector(FlakySettings(enabled=cfg.mock_erp.flaky_mode)); uvicorn.run(create_erp_app(db=db, flaky=flaky), host='0.0.0.0', port=8001, proxy_headers=True, forwarded_allow_ips='*')"]
