# Gemini Developer API Configuration (Phases P1-P3 Zero-Cost AI Studio Mode)
# Create a key at https://aistudio.google.com/app/apikey and place in .env (git-ignored)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud / Gemini Enterprise Agent Platform (Connected in Phase P4)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# ADK 2.x / google-genai 3.x enterprise toggle (replaces legacy GOOGLE_GENAI_USE_VERTEXAI)
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_GENAI_USE_VERTEXAI=false

# Legacy ERP Mock Service Configuration
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_PORT=8001
MOCK_ERP_FLAKY_MODE=false

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
